<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template, not a shipped file. @SERVICE_USER@ is substituted at install time
  with the account the install scanned for and recorded, because §9 forbids a
  compiled-in or written-in identity number.

  ProgramArguments points into root-owned storage and never into the Homebrew
  prefix. That is the whole reason this component exists: §0 measured that a
  root job pointing at an admin-writable path is a passwordless admin-to-root
  escalation.

  No KeepAlive. A helper that respawns after refusing something is a helper that
  hides the refusal; launchd's own log is the record, and the daemon reconnects.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>app.smbpal.helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/smbpal/smbpal-helper</string>
    <string>serve</string>
    <string>--service-user</string>
    <string>@SERVICE_USER@</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/var/log/smbpal-helper.log</string>
</dict>
</plist>
